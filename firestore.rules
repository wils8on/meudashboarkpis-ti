rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function currentEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/usuarios_autorizados/$(currentEmail()))
             && get(/databases/$(database)/documents/usuarios_autorizados/$(currentEmail())).data.status == 'permitido'
             && get(/databases/$(database)/documents/usuarios_autorizados/$(currentEmail())).data.role == 'admin';
    }

    function isAuthorized() {
      return signedIn()
             && exists(/databases/$(database)/documents/usuarios_autorizados/$(currentEmail()))
             && get(/databases/$(database)/documents/usuarios_autorizados/$(currentEmail())).data.status == 'permitido';
    }

    match /usuarios_autorizados/{email} {
      allow get: if signedIn() && (currentEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.email == email
                    && request.resource.data.status == 'permitido'
                    && request.resource.data.role == 'usuario';
      allow update: if isAdmin()
                    && request.resource.data.email == email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.status in ['permitido', 'bloqueado']
                    && (email != currentEmail()
                        || (request.resource.data.status == 'permitido'
                            && request.resource.data.role == 'admin'));
      allow delete: if isAdmin() && email != currentEmail();
    }

    match /clientes/{clientId} {
      allow read, delete: if request.auth != null
                          && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }

    match /tomticket_private/{documentId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /tomticket_metrics/{documentId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /solicitantes/{requesterId} {
      allow read: if isAuthorized();
      allow create, update, delete: if isAdmin();
    }

    match /solucoes_desenvolvidas/{solutionId} {
      allow read: if isAuthorized();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
